{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FieldConfiguration",
  "description": "Controlled Field data. Native DOM attributes, refs and callbacks are technical React bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "value"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string"
    },
    "size": {
      "$ref": "ui.schema.json#/definitions/ControlSize"
    },
    "helper": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "placeholder": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean"
    },
    "readOnly": {
      "type": "boolean"
    },
    "clearable": {
      "type": "boolean",
      "default": true
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "email",
        "tel",
        "url",
        "search",
        "password"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FieldOption"
      }
    }
  },
  "definitions": {
    "FieldOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        }
      }
    }
  }
}
